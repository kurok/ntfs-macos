+static BOOL inherited_blkdev(const char *device)
+{
+	struct stat fdbuf;
+	int fd = ntfs_device_inherited_fd(device);
+
+	return (fd >= 0) && !fstat(fd, &fdbuf) && S_ISBLK(fdbuf.st_mode);
+}
