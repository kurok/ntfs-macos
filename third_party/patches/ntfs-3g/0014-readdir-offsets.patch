+/*
+ * ntfs-macos 0014: a snapshot of one directory listing per open directory
+ * handle. The listing is read once from position 0 (at a READDIR with
+ * offset 0, or at the first READDIR of the handle) and READDIR is served
+ * from it, so a reply never ends inside an entry, entries removed or moved
+ * while the handle is read do not shift the others, and no listing buffer
+ * is shared between handles. The offset of an entry is its ntfs_readdir()
+ * position plus one (never 0); positions increase along the listing.
+ */
+typedef struct {
+	s64 pos;		/* ntfs_readdir() position of the entry */
+	u64 ino;
+	mode_t mode;
+	size_t name;		/* offset of the name in names[] */
+} ntfs_fuse_snap_entry_t;
+
+typedef struct ntfs_fuse_dirsnap {
+	struct ntfs_fuse_dirsnap *next;	/* live snapshots, to recognise fi->fh */
+	struct ntfs_fuse_dirsnap *prev;
+	ntfs_fuse_snap_entry_t *ents;
+	size_t count;
+	size_t cap;
+	char *names;
+	size_t used;
+	size_t size;
+	BOOL valid;
+} ntfs_fuse_dirsnap_t;
+
+	/*
+	 * each of the two arrays of a snapshot (entries, names) is limited to
+	 * this size: at most 2 GiB per open directory handle, about ten
+	 * million entries; a mount holds one snapshot per open handle
+	 */
+#define NTFS_FUSE_SNAP_MAX ((size_t)1 << 30)
+
+static ntfs_fuse_dirsnap_t *ntfs_fuse_dirsnaps;
