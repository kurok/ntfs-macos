# versions.env - pinned inputs for the macOS test VM (Environment B). Sourced by tart.sh.
# Plain KEY=value, no spaces around '='.

# tart CLI (Homebrew tap openai/tools/tart). Licence FSL-1.1-ALv2.
TART_VERSION=2.41.1

# Vanilla macOS 27.2 guest (Apple silicon), no extra tooling, Remote Login enabled.
# Pinned by manifest digest; the tags "latest" and "27.2" pointed at this digest on 2026-11-13.
GUEST_IMAGE_REPO=ghcr.io/cirruslabs/macos-golden-gate-vanilla
GUEST_IMAGE_TAG_AT_PIN=27.2
GUEST_IMAGE_DIGEST=sha256:b35695ce30453bcc1db961a476740be72a44c2a2e464b73ece1ff0fcac12a873

# Public, documented test login of that image (https://tart.run/quick-start/).
# Throwaway VM only; never reuse these anywhere else.
GUEST_USER=admin
GUEST_PASS=admin

# Every VM this tooling creates starts with this prefix; tart.sh refuses to touch others.
VM_PREFIX=ntfsmac-
