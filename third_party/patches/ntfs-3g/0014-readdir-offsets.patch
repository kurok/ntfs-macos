+/*
+ * ntfs-macos 0014: every directory handle gets a snapshot in fi->fh, except
+ * when a reparse plugin's opendir put its own value there; releasedir frees
+ * it and gives any other handle to the release path used before.
+ */
+static int ntfs_fuse_opendir_snap(const char *path,
+		struct fuse_file_info *fi)
+{
+	ntfs_fuse_dirsnap_t *snap;
+	int res = 0;
+
+#if !KERNELPERMS | (POSIXACLS & !KERNELACLS)
+	res = ntfs_fuse_opendir(path, fi);
+	if (res || fi->fh)
+		return res;
+#else
+	(void)path;
+#endif
+	snap = (ntfs_fuse_dirsnap_t*)ntfs_calloc(sizeof(*snap));
+	if (!snap)
+		return -ENOMEM;
+	snap->next = ntfs_fuse_dirsnaps;
+	if (snap->next)
+		snap->next->prev = snap;
+	ntfs_fuse_dirsnaps = snap;
+	fi->fh = (uintptr_t)snap;
+	return res;
+}
+
+static int ntfs_fuse_releasedir_snap(const char *path,
+		struct fuse_file_info *fi)
+{
+	ntfs_fuse_dirsnap_t *snap;
+
+	snap = ntfs_fuse_snap_find(fi->fh);
+	if (snap) {
+		if (snap->prev)
+			snap->prev->next = snap->next;
+		else
+			ntfs_fuse_dirsnaps = snap->next;
+		if (snap->next)
+			snap->next->prev = snap->prev;
+		free(snap->ents);
+		free(snap->names);
+		free(snap);
+		fi->fh = 0;
+		return 0;
+	}
+#if !KERNELPERMS | (POSIXACLS & !KERNELACLS)
+	return ntfs_fuse_release(path, fi);
+#else
+	(void)path;
+	return 0;
+#endif
+}
