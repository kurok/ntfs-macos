 }
 
+/*
+ * ntfs-macos patch 0006: the operations below call the ones above and write an
+ * "E" record on the session channel when a device write, sync or close of a
+ * writable device failed. errno and the result are passed on unchanged. A write
+ * to a read-only device is refused above with EROFS and is not a device failure.
+ */
+static int ntfsmac_unix_io_close(struct ntfs_device *dev)
+{
+	int open = NDevOpen(dev), ro = NDevReadOnly(dev), res, err;
+
+	res = ntfs_device_unix_io_close(dev);
+	err = errno;
+	if (res && open && !ro)
+		ntfsmac_errfd_error("close", err);
+	errno = err;
+	return res;
+}
+
+static s64 ntfsmac_unix_io_write(struct ntfs_device *dev, const void *buf,
+		s64 count)
+{
+	int ro = NDevReadOnly(dev), err;
+	s64 res;
+
+	res = ntfs_device_unix_io_write(dev, buf, count);
+	err = errno;
+	if (!ro && res != count)
+		ntfsmac_errfd_error("write", res < 0 ? err : EIO);
+	errno = err;
+	return res;
+}
+
+static s64 ntfsmac_unix_io_pwrite(struct ntfs_device *dev, const void *buf,
+		s64 count, s64 offset)
+{
+	int ro = NDevReadOnly(dev), err;
+	s64 res;
+
+	res = ntfs_device_unix_io_pwrite(dev, buf, count, offset);
+	err = errno;
+	if (!ro && res != count)
+		ntfsmac_errfd_error("pwrite", res < 0 ? err : EIO);
+	errno = err;
+	return res;
+}
+
+static int ntfsmac_unix_io_sync(struct ntfs_device *dev)
+{
+	int ro = NDevReadOnly(dev), res, err;
+
+	res = ntfs_device_unix_io_sync(dev);
+	err = errno;
+	if (res && !ro)
+		ntfsmac_errfd_error("sync", err);
+	errno = err;
+	return res;
+}
+
 /**
  * Device operations for working with unix style devices and files.
  */
 struct ntfs_device_operations ntfs_device_unix_io_ops = {
 	.open		= ntfs_device_unix_io_open,
-	.close		= ntfs_device_unix_io_close,
+	.close		= ntfsmac_unix_io_close,
 	.seek		= ntfs_device_unix_io_seek,
 	.read		= ntfs_device_unix_io_read,
-	.write		= ntfs_device_unix_io_write,
+	.write		= ntfsmac_unix_io_write,
 	.pread		= ntfs_device_unix_io_pread,
-	.pwrite		= ntfs_device_unix_io_pwrite,
-	.sync		= ntfs_device_unix_io_sync,
+	.pwrite		= ntfsmac_unix_io_pwrite,
+	.sync		= ntfsmac_unix_io_sync,
 	.stat		= ntfs_device_unix_io_stat,
 	.ioctl		= ntfs_device_unix_io_ioctl,
 };
