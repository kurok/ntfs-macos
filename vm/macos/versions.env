# versions.env - pinned inputs for the macOS test VM (Environment B). Sourced by tart.sh.
# Plain KEY=value, no spaces around '='.

# tart CLI (Homebrew tap openai/tools/tart). Licence FSL-1.1-ALv2.
TART_VERSION=2.41.1

# macOS 27.2 "base" guest (Apple silicon): vanilla plus Homebrew and the tart guest agent,
# so tart.sh can run commands with `tart exec` over virtio instead of host-to-guest SSH
# (which macOS Local Network privacy blocks for the calling app; see README.md).
# Pinned by manifest digest; the tag "latest" pointed at this digest on 2026-11-14
# (uploaded 2026-11-07). Previous pin: macos-golden-gate-vanilla@sha256:b35695ce...a873.
GUEST_IMAGE_REPO=ghcr.io/cirruslabs/macos-golden-gate-base
GUEST_IMAGE_TAG_AT_PIN=latest
GUEST_IMAGE_DIGEST=sha256:4859ea9483a1f6e377301f23a5243798044266a373fc36635e9dcd045e09292f

# Public, documented test login of that image (https://tart.run/quick-start/).
# Throwaway VM only; never reuse these anywhere else.
GUEST_USER=admin
GUEST_PASS=admin

# Every VM this tooling creates starts with this prefix; tart.sh refuses to touch others.
VM_PREFIX=ntfsmac-
