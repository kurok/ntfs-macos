#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
#
# preinstall of the ntfs-macos package (T-M6-01). Run as root by the Installer before any file is
# copied; a non-zero exit stops the install. Its output goes to the Installer log
# (/var/log/install.log). Every check comes first and changes nothing; only an upgrade of our own
# install changes something afterwards: the running daemon is stopped, and files that an earlier
# install of ours had and this package does not ship are removed.
#
# Refused (each with the reason in the log):
#   1. a target other than the startup volume; macOS older than 27; a Mac that is not arm64
#   2. macFUSE missing (/Library/Filesystems/macfuse.fs) or older than 5.5.0 (ADR-013; the version
#      is CFBundleShortVersionString, else CFBundleVersion, as distribution.xml reads it; the
#      worker links macFUSE's libfuse at /usr/local/lib/libfuse.2.dylib, which must be there too)
#   3. another NTFS driver (owner decision 2026-11-26; the earlier design warned, installed
#      and set passive mode): a bundle in /Library/Filesystems that src/daemon/conflict.c calls a
#      conflict (ufsd_NTFS.fs of Paragon, tuxera_ntfs.fs of Tuxera, any other *.fs with "ntfs" in
#      the name except Apple's ntfs.fs and our own ntfsmac*), or a kernel extension in
#      /Library/Extensions with "ntfs" in its name (ARCHITECTURE.md section 8.4, R-17)
#   4. a path the package installs that exists although no install of ours is recorded (no receipt
#      org.ntfs-macos.pkg.v2 or org.ntfs-macos.pkg and no /usr/local/libexec/ntfs-macos/manifest.txt
#      of a developer install), a path of ours that is a symbolic link or of the wrong type
#   5. a directory above an installed path that is a symbolic link, or is not a real directory
#      owned by root and not writable by group or others; the path is walked from / down and no
#      link is followed (M6-F01). Every installed path is one that root runs or reads
#      (/usr/local/libexec/ntfs-macos, /Library/Application Support/ntfs-macos,
#      /Library/LaunchDaemons); a user-owned /usr/local/bin or /usr/local/share (Homebrew) does
#      not matter, because the package puts nothing there (postinstall makes the optional link
#      /usr/local/bin/ntfsmac only when /usr/local/bin is root-only).
#   6. a downgrade (owner decision 2026-11-26, issue #10): this package's version (build-pkg.sh
#      writes it into new_version below) is older than the installed one, read from the receipt
#      org.ntfs-macos.pkg.v2 (pkgutil --pkg-info) or, without that receipt, from the installed
#      BUILD-INFO of a developer install. An older daemon does not read the format-2 journal
#      entries of a newer one, so it could mount read/write a volume that was left open.
#      An installed version that cannot be read is named in the log and not compared.
# An install of ours (an earlier package, or dev-install.sh) is upgraded; the same version is
# installed again.
#
# The package identifier is org.ntfs-macos.pkg.v2 (owner decision 2026-11-26, audit M6-F02). The
# earlier layout, among it the published pre-release v0.1.0-dev.20261116, used org.ntfs-macos.pkg.
# Because the identifiers differ, the Installer never treats this package as an upgrade of that
# receipt, so it never deletes the earlier receipt's files itself (that deletion follows a link in
# a user-owned /usr/local/share/doc). This script removes them instead, each only when its
# directory passes root_only_dir, and forgets the earlier receipt when none of its files that this
# package does not ship is left. Otherwise the receipt stays, and the log says to run
# `uninstall.sh --old-receipt` after the fix.
#
# Root-safe by construction: absolute program paths, a fixed PATH, no environment variable is
# read, no argument but the target volume ($3, compared with "/") is used, no string from outside
# is executed, no temporary file. A file is removed only when every directory from / down to its
# directory is a real directory (no symbolic link) and root-only. A path in a message is quoted for
# reading only and is never part of a suggested command.
set -eu
umask 022
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

tag='ntfs-macos preinstall'
say() { /usr/bin/printf '%s: %s\n' "$tag" "$*"; }
refuse() {
	/usr/bin/printf '%s: REFUSED: %s\n' "$tag" "$*"
	/usr/bin/printf '%s: REFUSED: %s\n' "$tag" "$*" >&2
	exit 1
}

pkg_id=org.ntfs-macos.pkg.v2
# the version of this package: packaging/build-pkg.sh replaces the placeholder (U-PKG-03 checks it)
new_version='@VERSION@'
build_info='/Library/Application Support/ntfs-macos/doc/BUILD-INFO'
old_pkg_id=org.ntfs-macos.pkg
job=org.ntfs-macos.ntfsmacd
fs_dir=/Library/Filesystems
macfuse=$fs_dir/macfuse.fs
libfuse=/usr/local/lib/libfuse.2.dylib
# NTFSMAC_MACFUSE_MIN_* of src/daemon/internal.h (the unit test U-PKG-03 keeps them equal)
min_major=5
min_minor=5
min_patch=0

# The dir and file entries of packaging/manifest.txt, in its order (U-PKG-03 keeps them equal).
paths='dir /usr/local/libexec/ntfs-macos
file /usr/local/libexec/ntfs-macos/ntfsmacd
file /usr/local/libexec/ntfs-macos/ntfsmac-worker
file /usr/local/libexec/ntfs-macos/ntfsmac-probe
file /usr/local/libexec/ntfs-macos/ntfsmac-volmark
file /usr/local/libexec/ntfs-macos/mkntfs
file /usr/local/libexec/ntfs-macos/ntfsfix
file /usr/local/libexec/ntfs-macos/ntfsinfo
file /usr/local/libexec/ntfs-macos/ntfslabel
file /usr/local/libexec/ntfs-macos/uninstall.sh
file /usr/local/libexec/ntfs-macos/manifest.txt
file /usr/local/libexec/ntfs-macos/ntfsmac
dir /Library/Application Support/ntfs-macos
file /Library/Application Support/ntfs-macos/cli-requirement
dir /Library/Application Support/ntfs-macos/sandbox
file /Library/Application Support/ntfs-macos/sandbox/probe.sb
file /Library/Application Support/ntfs-macos/sandbox/volmark.sb
file /Library/Application Support/ntfs-macos/sandbox/worker.sb
dir /Library/Application Support/ntfs-macos/doc
file /Library/Application Support/ntfs-macos/doc/COPYING
file /Library/Application Support/ntfs-macos/doc/README.md
file /Library/Application Support/ntfs-macos/doc/BUILD-INFO
file /Library/LaunchDaemons/org.ntfs-macos.ntfsmacd.plist'

# conflict NAME: the kind of driver a bundle name in /Library/Filesystems is (src/daemon/conflict.c
# ntfsmac_conflict_classify, case-insensitive), empty when it is none
conflict() {
	_n=$(/usr/bin/printf '%s' "$1" | /usr/bin/tr '[:upper:]' '[:lower:]')
	case $_n in
	'') ;;
	ufsd_ntfs.fs) /usr/bin/printf 'Paragon NTFS' ;;
	tuxera_ntfs.fs) /usr/bin/printf 'Tuxera NTFS' ;;
	ntfs.fs | ntfsmac*) ;;
	*ntfs*.fs) /usr/bin/printf 'another NTFS driver' ;;
	esac
}

# ver_older A B: 0 when version A is older than version B, 1 when it is not, 2 when either is not
# 1 to 4 numbers separated by dots (a missing number counts as 0, so 0.1 equals 0.1.0)
ver_older() {
	/usr/bin/awk -v a="$1" -v b="$2" 'function ok(v,  n, i, c) {
		if (v !~ /^[0-9]+(\.[0-9]+)*$/) return 0
		n = split(v, c, ".")
		if (n > 4) return 0
		for (i = 1; i <= n; i++) if (length(c[i]) > 9) return 0
		return 1
	}
	BEGIN {
		if (!ok(a) || !ok(b)) exit 2
		na = split(a, x, "."); nb = split(b, y, ".")
		for (i = 1; i <= 4; i++) {
			p = (i <= na) ? x[i] + 0 : 0; q = (i <= nb) ? y[i] + 0 : 0
			if (p < q) exit 0
			if (p > q) exit 1
		}
		exit 1
	}'
}

# >>> root-only check (M6-F01). The same text in packaging/scripts/preinstall,
# packaging/scripts/postinstall, packaging/uninstall.sh and packaging/dev-install.sh: a package
# script cannot source a file of the repository, so each carries a copy, and the unit test
# packaging.root_only (tests/unit/packaging/root_only_test.sh) keeps the copies equal.
#
# root_only_chain PATH: 0 when every component of the absolute PATH that exists, from / down to
# PATH itself, is a real directory owned by root, not writable by group or others and without an
# access control entry that allows anything (`ls -lde` shows "allow"; a deny-only list is fine,
# audit M6 review). PATH must not hold an empty, "." or ".." component. A symbolic link is never
# followed: a link at any component fails, so the directory that holds a link is
# always checked as well (a user-owned /usr/local with /usr/local/libexec a link to a root-only
# directory fails at /usr/local). The components below the first missing one do not exist yet,
# which is allowed. On failure ro_bad is the component that failed and ro_why the reason.
root_only_chain() {
	ro_bad=
	ro_why=
	case $1 in
	/*) ;;
	*) ro_bad=$1; ro_why='is not an absolute path'; return 1 ;;
	esac
	if [ "$1" != / ]; then
		case "$1/" in
		*/../* | */./* | *//*) ro_bad=$1; ro_why='has an empty component or a component that is a dot or two dots'; return 1 ;;
		esac
	fi
	ro_rest=${1#/}
	ro_p=/
	while :; do
		if [ -L "$ro_p" ]; then ro_bad=$ro_p; ro_why='is a symbolic link'; return 1; fi
		[ -e "$ro_p" ] || return 0
		if [ ! -d "$ro_p" ]; then ro_bad=$ro_p; ro_why='is not a directory'; return 1; fi
		ro_st=$(/usr/bin/stat -f '%Su %Lp' "$ro_p") || { ro_bad=$ro_p; ro_why='cannot be read'; return 1; }
		if [ "${ro_st% *}" != root ] || [ $((0${ro_st#* } & 022)) -ne 0 ]; then
			ro_bad=$ro_p
			ro_why="is owned by ${ro_st% *} with mode ${ro_st#* }"
			return 1
		fi
		ro_acl=$(/bin/ls -lde "$ro_p") || { ro_bad=$ro_p; ro_why='cannot be read'; return 1; }
		case $ro_acl in
		*"
"*" allow "*)
			ro_bad=$ro_p
			ro_why='has an access control entry that allows changes to it (ls -le shows it)'
			return 1
			;;
		esac
		[ -n "$ro_rest" ] || return 0
		ro_c=${ro_rest%%/*}
		case $ro_rest in */*) ro_rest=${ro_rest#*/} ;; *) ro_rest= ;; esac
		case $ro_c in '' | '.' | '..') ro_bad=$1; ro_why='has an empty component or a component that is a dot or two dots'; return 1 ;; esac
		if [ "$ro_p" = / ]; then ro_p=/$ro_c; else ro_p=$ro_p/$ro_c; fi
	done
}
# root_only_dir DIR: 0 when DIR exists and root_only_chain accepts it (DIR included)
root_only_dir() {
	ro_bad=
	ro_why=
	[ -d "$1" ] || { ro_bad=$1; ro_why='is missing'; return 1; }
	root_only_chain "$1"
}
# ro_show PATH: PATH for a message, in double quotes, for reading only. Each character other than
# a letter, a digit, a space or / . _ , : @ + = - is shown as ?, so a name that a user chose
# cannot end the quotes or add a command or a line to the log.
ro_show() {
	/usr/bin/printf '"%s"' "$(/usr/bin/printf '%s' "$1" | LC_ALL=C /usr/bin/tr -c 'A-Za-z0-9 /._,:@+=-' '?')"
}
# <<< root-only check

# ---- 1. target and system ----
[ "${3:-}" = / ] || refuse "ntfs-macos installs only on the startup volume /"
[ "$(/usr/bin/uname -m)" = arm64 ] || refuse "ntfs-macos runs only on Apple silicon (arm64)"
osv=$(/usr/bin/sw_vers -productVersion)
case $osv in [0-9]*) ;; *) refuse "cannot read the macOS version" ;; esac
[ "${osv%%.*}" -ge 27 ] || refuse "macOS 27 or newer is required; this Mac has macOS $osv"

# ---- 2. macFUSE ----
if [ -L "$macfuse" ] || [ ! -d "$macfuse" ]; then
	refuse "macFUSE is not installed ($macfuse is missing). Install macFUSE $min_major.$min_minor.$min_patch or newer from https://macfuse.github.io and turn its file system extension on in System Settings, then run this installer again. ntfs-macos does not include macFUSE."
fi
fv=$(/usr/bin/plutil -extract CFBundleShortVersionString raw -o - "$macfuse/Contents/Info.plist" 2>/dev/null) ||
	fv=$(/usr/bin/plutil -extract CFBundleVersion raw -o - "$macfuse/Contents/Info.plist" 2>/dev/null) || fv=
# "5.5.0", "5.5" or "5.5.1-beta" as the daemon reads it: the text after the digits is ignored
fv_num=$(/usr/bin/printf '%s\n' "$fv" | /usr/bin/sed -n 's/^\([0-9][0-9]*\(\.[0-9][0-9]*\)\{0,2\}\).*/\1/p')
[ -n "$fv_num" ] || refuse "cannot read the version of macFUSE ($macfuse/Contents/Info.plist); reinstall macFUSE $min_major.$min_minor.$min_patch or newer"
if ! /usr/bin/printf '%s\n' "$fv_num" | /usr/bin/awk -F. -v a="$min_major" -v b="$min_minor" -v c="$min_patch" \
	'{ x = $1 * 1000000 + $2 * 1000 + $3; exit (x >= a * 1000000 + b * 1000 + c) ? 0 : 1 }'; then
	refuse "macFUSE $fv is too old; ntfs-macos needs macFUSE $min_major.$min_minor.$min_patch or newer. Update macFUSE, then run this installer again."
fi
[ -f "$libfuse" ] || refuse "macFUSE $fv is installed but its library $libfuse is missing; reinstall macFUSE"
say "macFUSE $fv found"

# ---- 3. other NTFS drivers ----
found=
for e in "$fs_dir"/*; do
	[ -e "$e" ] || [ -L "$e" ] || continue
	k=$(conflict "${e##*/}")
	[ -z "$k" ] || found="$found $k ($e);"
done
for e in /Library/Extensions/*; do
	[ -e "$e" ] || [ -L "$e" ] || continue
	n=$(/usr/bin/printf '%s' "${e##*/}" | /usr/bin/tr '[:upper:]' '[:lower:]')
	case $n in *ntfs*.kext) found="$found an NTFS kernel extension ($e);" ;; esac
done
if [ -n "$found" ]; then
	refuse "another NTFS driver is installed:$found ntfs-macos does not install next to another NTFS driver, because two drivers could write to one volume. Remove the other driver with its own uninstaller first."
fi

# ---- 4. files in the way, and an earlier install of ours ----
ours=
if /usr/sbin/pkgutil --pkg-info "$pkg_id" >/dev/null 2>&1; then
	ours="package $(/usr/sbin/pkgutil --pkg-info "$pkg_id" | /usr/bin/sed -n 's/^version: //p')"
elif /usr/sbin/pkgutil --pkg-info "$old_pkg_id" >/dev/null 2>&1; then
	ours="package $(/usr/sbin/pkgutil --pkg-info "$old_pkg_id" | /usr/bin/sed -n 's/^version: //p') of the earlier layout"
elif [ -f /usr/local/libexec/ntfs-macos/manifest.txt ] && [ ! -L /usr/local/libexec/ntfs-macos/manifest.txt ] &&
	[ "$(/usr/bin/stat -f %Su /usr/local/libexec/ntfs-macos/manifest.txt)" = root ]; then
	ours="developer install"
fi
nl='
'
while IFS= read -r line; do
	kind=${line%% *}
	p=${line#* }
	if [ -L "$p" ]; then
		refuse "$p is a symbolic link; ntfs-macos installs a real file or directory there. Remove the link first."
	fi
	[ -e "$p" ] || continue
	[ -n "$ours" ] || refuse "$p exists, but no install of ntfs-macos is recorded on this Mac (no receipt $pkg_id or $old_pkg_id, no developer install). It may belong to other software; move it away, then run this installer again."
	case $kind in
	dir) [ -d "$p" ] || refuse "$p is not a directory" ;;
	file) [ -f "$p" ] || refuse "$p is not a regular file" ;;
	esac
done <<EOF
$paths
EOF

# ---- 5. every directory above an installed path is root-only ----
# root_only_chain walks each path from / down without following a symbolic link, so a link at
# /usr/local/libexec is refused, and so is a user-owned /usr/local that holds it (M6-F01).
checked=
while IFS= read -r line; do
	p=${line#* }
	d=${p%/*}
	[ -n "$d" ] || d=/
	case $checked in *"$nl$d$nl"*) continue ;; esac
	checked="$checked$nl$d$nl"
	if ! root_only_chain "$d"; then
		b=$(ro_show "$ro_bad")
		s=$(ro_show "$p")
		refuse "the directory $b above $s $ro_why. Every directory above a path that this package installs must be a real directory (not a symbolic link), owned by root and not writable by group or others; otherwise another user could replace a program that runs as root. Replace a symbolic link by a real directory, or give the directory to root and remove the write permission of group and others, then run this installer again."
	fi
done <<EOF
$paths
EOF

# ---- 6. no downgrade (owner decision 2026-11-26, issue #10) ----
# Before the daemon is stopped, so a refusal changes nothing.
case $new_version in
*@*) refuse "this preinstall has no package version (it was not prepared by packaging/build-pkg.sh)" ;;
esac
ver_older "$new_version" 0 && rc_v=0 || rc_v=$?
[ "$rc_v" -ne 2 ] || refuse "the version of this package cannot be read"
inst_ver=
inst_from=
if /usr/sbin/pkgutil --pkg-info "$pkg_id" >/dev/null 2>&1; then
	inst_ver=$(/usr/sbin/pkgutil --pkg-info "$pkg_id" | /usr/bin/sed -n 's/^version: //p' | /usr/bin/head -n 1)
	inst_from="the receipt $pkg_id"
elif [ -f "$build_info" ] && [ ! -L "$build_info" ] && [ "$(/usr/bin/stat -f %Su "$build_info")" = root ] &&
	root_only_dir "${build_info%/*}"; then
	inst_ver=$(/usr/bin/sed -n 's/^version[[:space:]][[:space:]]*//p' "$build_info" | /usr/bin/head -n 1)
	inst_from="the installed BUILD-INFO"
fi
if [ -n "$inst_from" ]; then
	ver_older "$new_version" "$inst_ver" && rc_v=0 || rc_v=$?
	case $rc_v in
	0) refuse "this package is ntfs-macos $new_version, older than the installed $inst_ver ($inst_from). A downgrade is refused: an older ntfs-macos does not read the session journal that a newer one wrote, so it could mount read/write a volume that was left open. Install version $inst_ver or newer. To go back on purpose, uninstall first (uninstall.sh) and check every NTFS volume with Windows chkdsk before you attach it." ;;
	2) say "the installed version ($inst_from) cannot be read; it is not compared with $new_version" ;;
	*) say "installed version $inst_ver ($inst_from); this package is $new_version" ;;
	esac
fi

say "preflight passed${ours:+ (upgrading the $ours)}"

# ---- upgrade: stop the daemon of the earlier install ----
# On SIGTERM it unmounts the volumes it serves and settles their sessions (ExitTimeOut 60).
if /bin/launchctl print "system/$job" >/dev/null 2>&1; then
	say "stopping the running daemon of the earlier install"
	/bin/launchctl bootout "system/$job" >/dev/null 2>&1 || true
	i=0
	while /bin/launchctl print "system/$job" >/dev/null 2>&1 && [ "$i" -lt 70 ]; do
		/bin/sleep 1
		i=$((i + 1))
	done
	if /bin/launchctl print "system/$job" >/dev/null 2>&1; then
		refuse "the running daemon $job was asked to stop but did not stop within 70 s; no file was installed or removed. It may still be stopping or may be stopped now. Unmount the NTFS volumes and run this installer again; to restart the earlier daemon instead: sudo launchctl bootstrap system /Library/LaunchDaemons/$job.plist"
	fi
fi

# ---- upgrade: files of an earlier install of ours that this package does not ship ----
# The candidates are the files of the earlier receipt and of the earlier installed manifest (a
# developer install has no receipt). Only below the directories the project owns or owned
# (/usr/local/libexec/ntfs-macos, /Library/Application Support/ntfs-macos, the earlier
# /usr/local/share/doc/ntfs-macos) and the earlier CLI file /usr/local/bin/ntfsmac; never a path
# with "..". A file is removed (rm -f: a link is removed, not followed) only when root_only_dir
# accepts its directory; else it is left and named in the log.
legacy() { # path: 0 when the path is a candidate region
	case $1 in
	*..* | *[[:cntrl:]]*) return 1 ;;
	/usr/local/libexec/ntfs-macos/* | "/Library/Application Support/ntfs-macos/"* | /usr/local/share/doc/ntfs-macos/* | /usr/local/bin/ntfsmac) return 0 ;;
	esac
	return 1
}
remove_old() { # path
	case "$nl$paths$nl" in *" $1$nl"*) return 0 ;; esac
	legacy "$1" || return 0
	[ -L "$1" ] || [ -f "$1" ] || return 0
	if ! root_only_dir "${1%/*}"; then
		say "left $1 of the earlier install: ${1%/*} is not root-only or is reached through a symbolic link; remove it yourself"
		return 0
	fi
	say "removing $1 (the earlier install had it; this package does not)"
	/bin/rm -f "$1"
	_d=${1%/*}
	while :; do
		case $_d in
		/usr/local/libexec/ntfs-macos/* | "/Library/Application Support/ntfs-macos/"* | /usr/local/share/doc/ntfs-macos | /usr/local/share/doc/ntfs-macos/*) ;;
		*) break ;;
		esac
		case "$nl$paths$nl" in *"${nl}dir $_d$nl"*) break ;; esac
		root_only_dir "$_d" || break
		/bin/rmdir "$_d" 2>/dev/null || break
		_d=${_d%/*}
	done
}
old_manifest=/usr/local/libexec/ntfs-macos/manifest.txt
{
	for rid in "$pkg_id" "$old_pkg_id"; do
		if /usr/sbin/pkgutil --pkg-info "$rid" >/dev/null 2>&1; then
			/usr/sbin/pkgutil --only-files --files "$rid" | /usr/bin/sed 's|^|/|'
		fi
	done
	if [ -f "$old_manifest" ] && [ ! -L "$old_manifest" ] && [ "$(/usr/bin/stat -f %Su "$old_manifest")" = root ]; then
		/usr/bin/awk '/^[ \t]*(#|$)/ { next } $1 == "file" { p = $0; for (i = 0; i < 4; i++) sub(/^[ \t]*[^ \t]+/, "", p); sub(/^[ \t]+/, "", p); sub(/[ \t]+$/, "", p); print p }' "$old_manifest"
	fi
} | /usr/bin/sort -u | while IFS= read -r f; do
	remove_old "$f"
done

# ---- upgrade: the receipt of the earlier layout (audit M6-F02) ----
# Forgotten when every file of it that this package does not ship is gone; else kept, so that
# `uninstall.sh --old-receipt` can remove the rest after the fix.
old_left() { # one line for each file of the earlier receipt that is still there and not ours now
	/usr/sbin/pkgutil --only-files --files "$old_pkg_id" | while IFS= read -r f; do
		case "$nl$paths$nl" in *" /$f$nl"*) continue ;; esac
		if [ -e "/$f" ] || [ -L "/$f" ]; then /usr/bin/printf '%s\n' x; fi
	done
}
if /usr/sbin/pkgutil --pkg-info "$old_pkg_id" >/dev/null 2>&1; then
	left=$(old_left | /usr/bin/wc -l | /usr/bin/tr -d ' ')
	if [ "$left" -eq 0 ]; then
		/usr/sbin/pkgutil --forget "$old_pkg_id" >/dev/null
		say "forgot the receipt $old_pkg_id of the earlier layout (none of its files that this package does not ship is left)"
	else
		say "kept the receipt $old_pkg_id of the earlier layout: $left of its files are still there (named above, in a directory that is not root-only or is reached through a symbolic link). After the fix, run: sudo /usr/local/libexec/ntfs-macos/uninstall.sh --old-receipt (or the uninstall.sh of the release, checked against its SHA256SUMS)"
	fi
fi
exit 0
