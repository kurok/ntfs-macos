diff -ruN a/libntfs-3g/unix_io.c b/libntfs-3g/unix_io.c
--- a/libntfs-3g/unix_io.c	2026-11-15 09:24:13.336542208 +0000
+++ b/libntfs-3g/unix_io.c	2026-11-15 09:58:05.332035661 +0000
@@ -56,6 +56,8 @@
 #ifdef HAVE_LINUX_FS_H
 #include <linux/fs.h>
 #endif
+#include <signal.h>
+#include <pthread.h>
 
 #include "types.h"
 #include "mst.h"
@@ -105,6 +107,207 @@
 #	define O_EXCL 0
 #endif
 
+/*
+ * ntfs-macos patch 0006 (ADR-018): the session channel.
+ *
+ * If the environment variable NTFSMAC_ERRFD names an open pipe or socket, a few
+ * fixed-format ASCII records are written to it, one write() each, at most 32
+ * bytes with the newline:
+ *	S rw|ro		the volume is mounted (src/ntfs-3g.c main())
+ *	E <op> <errno>	a device-level failure (op: pwrite, write, sync, close;
+ *			src/ntfs-3g.c also writes "E umount <errno>")
+ *	W flush <errno>	the drive flush failed (see ntfs_fsync())
+ *	U <n>		the volume was released without error (ntfs_close());
+ *			n is the number of E records tried
+ * Every record text is a literal of this file plus decimal integers; nothing is
+ * taken from the disk. Without the variable, or when it does not name a pipe or
+ * socket that is writable, nothing is written and nothing changes.
+ * The descriptor gets FD_CLOEXEC and O_NONBLOCK when it is first looked at (at
+ * device open, before the FUSE mount), so no program started later inherits it
+ * and a full pipe drops the record instead of blocking. A reader that went away
+ * gives EPIPE; SIGPIPE is blocked around the write and discarded, so it never
+ * ends the process. A failed or dropped write is not retried and is not an error
+ * for the caller. At most NTFSMAC_ERRFD_MAXE E and NTFSMAC_ERRFD_MAXW W records
+ * are written (with S and U that is below the 64 of the daemon's bound); further
+ * ones are still counted for U.
+ */
+#define NTFSMAC_ERRFD_MAXE 30
+#define NTFSMAC_ERRFD_MAXW 30
+
+static int ntfsmac_errfd = -1;
+static int ntfsmac_errfd_read;		/* the variable was looked at */
+static int ntfsmac_errfd_nerr;		/* E records tried */
+static int ntfsmac_errfd_nwarn;		/* W records tried */
+static int ntfsmac_errfd_started;	/* S was tried */
+static int ntfsmac_errfd_nosigpipe;	/* F_SETNOSIGPIPE took effect */
+
+static int ntfsmac_count(int *counter)
+{
+#if defined(__GNUC__)
+	return __sync_fetch_and_add(counter, 1);
+#else
+	return (*counter)++;
+#endif
+}
+
+static void ntfsmac_errfd_init(void)
+{
+	const char *env;
+	char *end;
+	long n;
+	struct stat st;
+	int fd, fl, fdfl, saved = errno;
+
+	if (ntfsmac_errfd_read)
+		return;
+	ntfsmac_errfd_read = 1;
+	env = getenv("NTFSMAC_ERRFD");
+	if (!env || *env < '0' || *env > '9')
+		goto out;
+	n = strtol(env, &end, 10);
+	if (*end || n < 3 || n > 100000)
+		goto out;
+	fd = (int)n;
+	/* Only a pipe or a socket: never a device or a file. */
+	if (fstat(fd, &st) || !(S_ISFIFO(st.st_mode) || S_ISSOCK(st.st_mode)))
+		goto out;
+	fl = fcntl(fd, F_GETFL);
+	fdfl = fcntl(fd, F_GETFD);
+	if (fl == -1 || fdfl == -1 || (fl & O_ACCMODE) == O_RDONLY)
+		goto out;
+	if (fcntl(fd, F_SETFD, fdfl | FD_CLOEXEC) == -1)
+		goto out;
+	if (fcntl(fd, F_SETFL, fl | O_NONBLOCK) == -1)
+		goto out;
+#ifdef F_SETNOSIGPIPE
+	if (fcntl(fd, F_SETNOSIGPIPE, 1) != -1)
+		ntfsmac_errfd_nosigpipe = 1;
+#endif
+	ntfsmac_errfd = fd;
+	/* Children (system(), the mount helper) must not see the variable. */
+	unsetenv("NTFSMAC_ERRFD");
+#if defined(ENABLE_FAULTIO)
+	/*
+	 * Test hook (I-ERR-07), faultio builds only: report the flags of the
+	 * channel, then run the command in NTFSMAC_FAULT_ERRFD_CMD through
+	 * system(), to show that the child has no copy of it.
+	 */
+	{
+		const char *cmd = getenv("NTFSMAC_FAULT_ERRFD_CMD");
+
+		if (cmd && getuid() == geteuid() && getgid() == getegid()) {
+			fprintf(stderr, "ntfsmac-errfd-hook: fd=%d fdflags=%d "
+				"flflags=%d\n", fd, fcntl(fd, F_GETFD),
+				fcntl(fd, F_GETFL));
+			fflush(stderr);
+			if (system(cmd))
+				fprintf(stderr, "ntfsmac-errfd-hook: "
+					"command failed\n");
+		}
+	}
+#endif
+out:
+	errno = saved;
+}
+
+static void ntfsmac_errfd_put(const char *buf, int len)
+{
+	sigset_t set, old, pend;
+	int saved = errno, tries = 0, wasp, sig;
+	ssize_t r;
+
+	if (ntfsmac_errfd_nosigpipe) {
+		/* The kernel does not raise SIGPIPE for this descriptor. */
+		do
+			r = write(ntfsmac_errfd, buf, len);
+		while (r < 0 && errno == EINTR && ++tries < 4);
+		goto out;
+	}
+	sigemptyset(&set);
+	sigaddset(&set, SIGPIPE);
+	if (pthread_sigmask(SIG_BLOCK, &set, &old))
+		goto out;
+	sigemptyset(&pend);
+	wasp = !sigpending(&pend) && sigismember(&pend, SIGPIPE) == 1;
+	do
+		r = write(ntfsmac_errfd, buf, len);
+	while (r < 0 && errno == EINTR && ++tries < 4);
+	if (r < 0 && errno == EPIPE && !wasp) {
+		sigemptyset(&pend);
+		if (!sigpending(&pend) && sigismember(&pend, SIGPIPE) == 1) {
+#if defined(__linux__)
+			struct timespec zero = { 0, 0 };
+
+			(void)sigtimedwait(&set, NULL, &zero);	/* never blocks */
+			(void)sig;
+#else
+			(void)sigwait(&set, &sig);	/* already pending */
+#endif
+		}
+	}
+	pthread_sigmask(SIG_SETMASK, &old, NULL);
+out:
+	errno = saved;
+}
+
+static void ntfsmac_errfd_rec(char kind, const char *op, int err)
+{
+	char buf[32];
+	int n;
+
+	if (err <= 0)
+		err = EIO;
+	n = snprintf(buf, sizeof(buf), "%c %s %d\n", kind, op, err);
+	if (n > 0 && n < (int)sizeof(buf))
+		ntfsmac_errfd_put(buf, n);
+}
+
+/* S rw|ro: the volume is mounted. At most once. */
+void ntfsmac_errfd_session(int readonly)
+{
+	ntfsmac_errfd_init();
+	if (ntfsmac_errfd < 0 || ntfsmac_count(&ntfsmac_errfd_started))
+		return;
+	ntfsmac_errfd_put(readonly ? "S ro\n" : "S rw\n", 5);
+}
+
+/* E <op> <err>: counted for U even when it is not written. */
+void ntfsmac_errfd_error(const char *op, int err)
+{
+	int saved = errno;
+
+	ntfsmac_errfd_init();
+	if (ntfsmac_count(&ntfsmac_errfd_nerr) < NTFSMAC_ERRFD_MAXE
+	    && ntfsmac_errfd >= 0)
+		ntfsmac_errfd_rec('E', op, err);
+	errno = saved;
+}
+
+/* W <op> <err>: the session is still usable, a report only. */
+void ntfsmac_errfd_warn(const char *op, int err)
+{
+	int saved = errno;
+
+	ntfsmac_errfd_init();
+	if (ntfsmac_count(&ntfsmac_errfd_nwarn) < NTFSMAC_ERRFD_MAXW
+	    && ntfsmac_errfd >= 0)
+		ntfsmac_errfd_rec('W', op, err);
+	errno = saved;
+}
+
+/* U <n>: only after S, and only when the volume was released without error. */
+void ntfsmac_errfd_unmounted(void)
+{
+	char buf[32];
+	int n;
+
+	if (ntfsmac_errfd < 0 || !ntfsmac_errfd_started)
+		return;
+	n = snprintf(buf, sizeof(buf), "U %d\n", ntfsmac_errfd_nerr);
+	if (n > 0 && n < (int)sizeof(buf))
+		ntfsmac_errfd_put(buf, n);
+}
+
