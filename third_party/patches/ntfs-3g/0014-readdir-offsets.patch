+/*
+ * ntfs-macos 0014: the snapshot that fh points to, or NULL if it is not one
+ * of ours. The walk costs one step per open directory handle of the mount,
+ * once per READDIR and releasedir; ntfs-3g runs one thread, so no lock.
+ */
+static ntfs_fuse_dirsnap_t *ntfs_fuse_snap_find(u64 fh)
+{
+	ntfs_fuse_dirsnap_t *snap;
+
+	for (snap = ntfs_fuse_dirsnaps; snap; snap = snap->next)
+		if ((u64)(uintptr_t)snap == fh)
+			return snap;
+	return (ntfs_fuse_dirsnap_t*)NULL;
+}
+
+/* ntfs-macos 0014: append one entry; -1 with errno ENOMEM when it cannot */
+static int ntfs_fuse_snap_add(ntfs_fuse_dirsnap_t *snap, const char *name,
+		const struct stat *st, s64 pos)
+{
+	size_t len = strlen(name) + 1;
+	size_t ncap, nsize;
+	void *p;
+
+	if (snap->count == snap->cap) {
+		ncap = snap->cap ? 2 * snap->cap : 64;
+		if (ncap > NTFS_FUSE_SNAP_MAX / sizeof(*snap->ents))
+			goto nomem;
+		p = realloc(snap->ents, ncap * sizeof(*snap->ents));
+		if (!p)
+			goto nomem;
+		snap->ents = (ntfs_fuse_snap_entry_t*)p;
+		snap->cap = ncap;
+	}
+	if (len > snap->size - snap->used) {
+		nsize = snap->size ? snap->size : 4096;
+		while (nsize - snap->used < len) {
+			if (nsize > NTFS_FUSE_SNAP_MAX / 2)
+				goto nomem;
+			nsize *= 2;
+		}
+		p = realloc(snap->names, nsize);
+		if (!p)
+			goto nomem;
+		snap->names = (char*)p;
+		snap->size = nsize;
+	}
+	memcpy(snap->names + snap->used, name, len);
+	snap->ents[snap->count].pos = pos;
+	snap->ents[snap->count].ino = st->st_ino;
+	snap->ents[snap->count].mode = st->st_mode;
+	snap->ents[snap->count].name = snap->used;
+	snap->used += len;
+	snap->count++;
+	return 0;
+nomem:
+	ntfs_log_error("Directory listing too large for the memory\n");
+	errno = ENOMEM;
+	return -1;
+}
+
+/*
+ * ntfs-macos 0014: give libfuse the entries after the offset until it
+ * refuses one (buffer full); the next READDIR asks again from the offset of
+ * the last entry it took, so the refused one comes again.
+ */
+static void ntfs_fuse_snap_serve(ntfs_fuse_dirsnap_t *snap, void *buf,
+		fuse_fill_dir_t filler, off_t offset)
+{
+	struct stat st;
+	size_t lo = 0, hi = snap->count, mid, i;
+
+	while (lo < hi) {	/* the first entry whose offset is above offset */
+		mid = lo + (hi - lo) / 2;
+		if (snap->ents[mid].pos + 1 <= (s64)offset)
+			lo = mid + 1;
+		else
+			hi = mid;
+	}
+	for (i = lo; i < snap->count; i++) {
+		memset(&st, 0, sizeof(st));
+		st.st_ino = snap->ents[i].ino;
+		st.st_mode = snap->ents[i].mode;
+		if (filler(buf, snap->names + snap->ents[i].name, &st,
+				(off_t)(snap->ents[i].pos + 1)))
+			break;
+	}
+}
