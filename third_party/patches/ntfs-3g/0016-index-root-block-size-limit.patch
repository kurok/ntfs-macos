+/*
+ *		Check the index_block_size read from an INDEX_ROOT
+ *	(ntfs-macos 0016)
+ *
+ *	It must be a power of two between the sector size and
+ *	NTFS_MACOS_MAX_INDEX_BLOCK_SIZE. It is not compared with the INDX
+ *	record size of the boot sector. Every user of an INDEX_ROOT
+ *	allocates, reads or writes blocks of that size.
+ */
+
+BOOL ntfs_index_block_size_valid(u32 block_size)
+{
+	if (block_size < NTFS_BLOCK_SIZE
+	    || block_size > NTFS_MACOS_MAX_INDEX_BLOCK_SIZE
+	    || (block_size & (block_size - 1)))
+		return FALSE;
+	return TRUE;
+}
+
