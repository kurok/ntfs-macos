<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-2.0-or-later -->
<!-- Entitlements for a Developer ID signed program that loads macFUSE's libfuse
     (/usr/local/lib/libfuse.2.dylib, signed by another team). With the hardened runtime and
     without this entitlement, library validation refuses that library and the program cannot start.
     Used by packaging/sign-and-notarize.sh for every Mach-O file whose `otool -L` lists
     /usr/local/lib/libfuse*; no other program gets it. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
