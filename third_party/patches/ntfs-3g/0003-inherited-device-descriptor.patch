@@ -66,6 +66,40 @@
 
 #define DEV_FD(dev)	(*(int *)dev->d_private)
 
+#ifdef __APPLE__
+/**
+ * ntfs_device_inherited_fd - descriptor named by a "/dev/fd/N" device name
+ * @name:	device name as given by the user
+ *
+ * ntfs-macos patch 0003. Return N if @name is exactly "/dev/fd/N" (N decimal,
+ * no sign, no leading zero, N >= 3) and N is an open descriptor of this
+ * process; otherwise return -1. Such a descriptor was opened, and its access
+ * checked, by whoever passed it; using it grants nothing the process does not
+ * already hold. On macOS, open("/dev/fd/N") re-checks the permissions of the
+ * underlying file for the caller and fails with EACCES for an unprivileged
+ * process, and realpath() rewrites the name, so the descriptor is used directly.
+ */
+int ntfs_device_inherited_fd(const char *name)
+{
+	const char *p;
+	long n = 0;
+
+	if (!name || strncmp(name, "/dev/fd/", 8))
+		return -1;
+	p = name + 8;
+	if (*p < '1' || *p > '9')
+		return -1;
+	for (; *p; p++) {
+		if (*p < '0' || *p > '9' || n > 100000)
+			return -1;
+		n = n * 10 + (*p - '0');
+	}
+	if (n < 3 || fcntl((int)n, F_GETFD) == -1)
+		return -1;
+	return (int)n;
+}
+#endif /* __APPLE__ */
+
 /* Define to nothing if not present on this system. */
 #ifndef O_EXCL
 #	define O_EXCL 0
